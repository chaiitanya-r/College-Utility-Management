# Environment Configuration for College Utility Management Backend
NODE_ENV=development
PORT=4000

# Database Configuration
# MongoDB connection string (e.g. local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/college_utility_management

# Security & JWT Configuration (generate a strong random secret in production)
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Cloudinary Configuration (Optional - for facility and profile photo uploads)
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET_KEY=your_cloudinary_api_secret

# SMTP Email Configuration (Nodemailer)
EMAIL=your-smtp-email@example.com
EMAIL_PASSWORD=your-smtp-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_FROM=noreply@college-utility.local
EMAIL_FROM_NAME="College Utility Management"

# Frontend Client URL (for CORS and email redirect links)
FRONTEND_URL=http://localhost:5173

# Initial Super Administrator Credentials
SUPERADMIN_EMAIL=superadmin@college.edu
SUPERADMIN_PASSWORD=change-me-to-a-secure-password

# Optional: Google Gemini API Key for Conversational AI Assistant
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash